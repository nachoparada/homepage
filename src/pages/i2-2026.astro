	<meta name="description" content="Versión imprimible de la Interrogación 2 de Seguridad Computacional." />
	<title>Interrogación 2 · Seguridad Computacional</title>
	<style>
		:root { font-family: Georgia, "Times New Roman", serif; color: #111; background: #ece9e1; }
