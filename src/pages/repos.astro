---
const repos = [
	{
		name: "homepage",
		visibility: "Public",
		url: "https://github.com/nachoparada/homepage",
		stack: "Astro · JavaScript",
		description:
			"The source for this personal website, built with Astro and deployed automatically through Cloudflare Pages.",
	},
	{
		name: "IIC2531",
		visibility: "Public",
		url: "https://github.com/nachoparada/IIC2531",
		stack: "Marp · Markdown",
		description:
			"Course material and Marp presentations for IIC2531, Computer Security at Pontificia Universidad Católica de Chile.",
	},
	{
		name: "IIC2531-26-01-labs",
		visibility: "Public",
		url: "https://github.com/nachoparada/IIC2531-26-01-labs",
		stack: "Python · C · Shell · Assembly",
		description:
			"Lab material and supporting code for the 2026-01 edition of IIC2531, focused on practical computer security exercises.",
	},
	{
		name: "disc-mods",
		visibility: "Private",
		url: null,
		stack: "OpenClaw · Agent skills · Security validation",
		description:
			"Private extended-skill modules for sandboxed agents in The Grid, enabling privileged operations through validated, security-aware disc-mod packages.",
	},
	{
		name: "io-tower",
		visibility: "Private",
		url: null,
		stack: "Chrome Extension · Browser automation",
		description:
			"Private OpenClaw browser relay extension that connects a browser to OpenClaw Gateway for remote AI-powered navigation, clicking, typing, and extraction.",
	},
	{
		name: "nexus",
		visibility: "Private",
		url: null,
		stack: "Python · HTML · Shell",
		description:
			"Private multi-server management system for OpenClaw deployments, used to monitor servers, collect configuration, track agents and disc-mods, and coordinate deployments.",
	},
	{
		name: "the-grid",
		visibility: "Private",
		url: null,
		stack: "Ansible · OpenClaw · Infrastructure",
		description:
			"Private Ansible deployment system for OpenClaw: automated, hardened host setup with security posture, service configuration, and operational automation.",
	},
	{
		name: "openclaw-ansible",
		visibility: "Public",
		url: "https://github.com/nachoparada/openclaw-ansible",
		stack: "Shell · Ansible · Jinja",
		description:
			"Automated, hardened OpenClaw installation with Tailscale VPN, UFW firewall, Docker isolation, and multi-OS deployment support.",
	},
];
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta
			name="description"
			content="Selected public and private repositories by Ignacio Parada."
		/>
		<title>Repositories · Ignacio Parada</title>
		<style>
			:root {
				color-scheme: dark;
				font-family:
					Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
					"Segoe UI", sans-serif;
				color: #f8fafc;
				background: #020617;
			}

			* {
				box-sizing: border-box;
			}

			body {
				min-height: 100vh;
				margin: 0;
				background:
					radial-gradient(circle at top left, rgba(59, 130, 246, 0.18), transparent 34rem),
					radial-gradient(circle at bottom right, rgba(14, 165, 233, 0.14), transparent 32rem),
					#020617;
			}

			a {
				color: inherit;
				text-decoration: none;
			}

			.page {
				width: min(1120px, calc(100% - 40px));
				margin: 0 auto;
				padding: 32px 0 56px;
			}

			header {
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 24px;
				padding: 8px 0 58px;
			}

			.logo {
				font-weight: 800;
				letter-spacing: -0.04em;
			}

			nav {
				display: flex;
				gap: 18px;
				color: #94a3b8;
				font-size: 0.95rem;
			}

			nav a:hover {
				color: #f8fafc;
			}

			.kicker {
				display: inline-flex;
				margin: 0 0 20px;
				padding: 8px 12px;
				border: 1px solid rgba(147, 197, 253, 0.28);
				border-radius: 999px;
				background: rgba(59, 130, 246, 0.1);
				color: #bfdbfe;
				font-size: 0.78rem;
				font-weight: 800;
				letter-spacing: 0.12em;
				text-transform: uppercase;
			}

			h1 {
				max-width: 880px;
				margin: 0;
				font-size: clamp(3rem, 7vw, 6rem);
				line-height: 0.94;
				letter-spacing: -0.075em;
			}

			.lede {
				max-width: 760px;
				margin: 24px 0 0;
				color: #cbd5e1;
				font-size: clamp(1.08rem, 2vw, 1.25rem);
				line-height: 1.65;
			}

			.repo-grid {
				display: grid;
				grid-template-columns: repeat(2, minmax(0, 1fr));
				gap: 18px;
				margin-top: 48px;
			}

			.repo-card {
				display: flex;
				min-height: 260px;
				flex-direction: column;
				justify-content: space-between;
				padding: 24px;
				border: 1px solid rgba(148, 163, 184, 0.18);
				border-radius: 26px;
				background: rgba(15, 23, 42, 0.68);
				box-shadow: 0 20px 60px rgba(0, 0, 0, 0.22);
			}

			.repo-card.private {
				border-color: rgba(251, 191, 36, 0.28);
				background: linear-gradient(145deg, rgba(15, 23, 42, 0.78), rgba(120, 53, 15, 0.18));
			}

			.repo-top {
				display: flex;
				align-items: flex-start;
				justify-content: space-between;
				gap: 18px;
			}

			.repo-name {
				margin: 0;
				font-size: 1.35rem;
				letter-spacing: -0.035em;
			}

			.badge {
				flex: 0 0 auto;
				padding: 6px 10px;
				border-radius: 999px;
				background: rgba(34, 197, 94, 0.12);
				color: #bbf7d0;
				font-size: 0.75rem;
				font-weight: 800;
				letter-spacing: 0.08em;
				text-transform: uppercase;
			}

			.badge.private {
				background: rgba(251, 191, 36, 0.14);
				color: #fde68a;
			}

			.description {
				margin: 18px 0 0;
				color: #cbd5e1;
				line-height: 1.6;
			}

			.stack {
				margin: 18px 0 0;
				color: #93c5fd;
				font-size: 0.94rem;
				font-weight: 700;
			}

			.repo-footer {
				margin-top: 28px;
				color: #94a3b8;
				font-size: 0.95rem;
			}

			.repo-footer a {
				color: #f8fafc;
				font-weight: 800;
			}

			.repo-footer a:hover {
				color: #bfdbfe;
			}

			.private-note {
				color: #fde68a;
			}

			footer {
				display: flex;
				flex-wrap: wrap;
				gap: 16px;
				justify-content: space-between;
				margin-top: 56px;
				padding-top: 24px;
				border-top: 1px solid rgba(148, 163, 184, 0.18);
				color: #94a3b8;
				font-size: 0.95rem;
			}

			@media (max-width: 780px) {
				.repo-grid {
					grid-template-columns: 1fr;
				}
			}

			@media (max-width: 560px) {
				.page {
					width: min(100% - 28px, 1120px);
					padding-top: 22px;
				}

				header {
					align-items: flex-start;
					flex-direction: column;
					gap: 14px;
					padding-bottom: 40px;
				}

				nav {
					flex-wrap: wrap;
				}

				.repo-top {
					align-items: flex-start;
					flex-direction: column;
				}
			}
		</style>
	</head>
	<body>
		<div class="page">
			<header>
				<a class="logo" href="/">Ignacio Parada</a>
				<nav aria-label="Primary navigation">
					<a href="/">Home</a>
					<a href="/repos/">Repos</a>
					<a href="mailto:yo@ignacioparada.com">Email</a>
					<a href="https://www.linkedin.com/in/iparada/">LinkedIn</a>
				</nav>
			</header>

			<main>
				<section aria-labelledby="repos-title">
					<p class="kicker">Code & projects</p>
					<h1 id="repos-title">Repositories I’m working with.</h1>
					<p class="lede">
						A short map of selected repositories, spanning teaching material, infrastructure automation, OpenClaw tooling, and this site itself. Private repositories are listed for context, but are not publicly accessible.
					</p>

					<div class="repo-grid">
						{repos.map((repo) => (
							<article class={`repo-card ${repo.visibility === "Private" ? "private" : ""}`}>
								<div>
									<div class="repo-top">
										<h2 class="repo-name">{repo.name}</h2>
										<span class={`badge ${repo.visibility === "Private" ? "private" : ""}`}>
											{repo.visibility}
										</span>
									</div>
									<p class="description">{repo.description}</p>
									<p class="stack">{repo.stack}</p>
								</div>
								<div class="repo-footer">
									{repo.url ? (
										<a href={repo.url}>View on GitHub →</a>
									) : (
										<span class="private-note">Private repository — access restricted</span>
									)}
								</div>
							</article>
						))}
					</div>
				</section>
			</main>

			<footer>
				<span>Santiago, Chile</span>
				<span>Public and private repository overview</span>
			</footer>
		</div>
	</body>
</html>
