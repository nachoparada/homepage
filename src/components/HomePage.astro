---
const { content } = Astro.props;
const esPrefix = content.lang === "es" ? "/es" : "";
---
<html lang={content.lang}>
<head>
<meta charset="utf-8" /><link rel="icon" type="image/svg+xml" href="/favicon.svg" /><link rel="icon" href="/favicon.ico" /><meta name="viewport" content="width=device-width" /><meta name="generator" content={Astro.generator} /><meta name="description" content={content.description} />
<link rel="alternate" hreflang="en" href="https://ignacioparada.com/" /><link rel="alternate" hreflang="es" href="https://ignacioparada.com/es/" /><title>Ignacio Parada</title>
<style>
:root{color-scheme:dark;font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:#f8fafc;background:#020617}*{box-sizing:border-box}body{min-height:100vh;margin:0;background:radial-gradient(circle at top left,rgba(59,130,246,.18),transparent 34rem),radial-gradient(circle at bottom right,rgba(14,165,233,.14),transparent 32rem),#020617}a{color:inherit;text-decoration:none}.page{width:min(1120px,calc(100% - 40px));margin:0 auto;padding:32px 0 56px}header{display:flex;align-items:center;justify-content:space-between;gap:24px;padding:8px 0 64px}.logo{font-weight:800;letter-spacing:-.04em}nav{display:flex;gap:18px;color:#94a3b8;font-size:.95rem;align-items:center;flex-wrap:wrap}nav a:hover{color:#f8fafc}.lang{padding-left:6px;border-left:1px solid rgba(148,163,184,.3)}.hero{display:grid;grid-template-columns:minmax(0,1.1fr) 360px;gap:64px;align-items:center}.kicker{display:inline-flex;margin:0 0 20px;padding:8px 12px;border:1px solid rgba(147,197,253,.28);border-radius:999px;background:rgba(59,130,246,.1);color:#bfdbfe;font-size:.78rem;font-weight:800;letter-spacing:.12em;text-transform:uppercase}h1{max-width:820px;margin:0;font-size:clamp(3.4rem,8vw,6.8rem);line-height:.92;letter-spacing:-.08em}.lede{max-width:720px;margin:28px 0 0;color:#cbd5e1;font-size:clamp(1.15rem,2vw,1.35rem);line-height:1.65}.actions{display:flex;flex-wrap:wrap;gap:14px;margin-top:34px}.button{display:inline-flex;align-items:center;justify-content:center;min-height:46px;padding:0 18px;border-radius:999px;font-weight:800}.button.primary{background:#f8fafc;color:#020617}.button.secondary{border:1px solid rgba(148,163,184,.28);color:#e2e8f0}.portrait-card{position:relative;padding:16px;border:1px solid rgba(148,163,184,.22);border-radius:36px;background:linear-gradient(145deg,rgba(15,23,42,.86),rgba(30,41,59,.42));box-shadow:0 28px 90px rgba(0,0,0,.38)}.portrait-card:before{position:absolute;inset:-1px;z-index:-1;border-radius:36px;background:linear-gradient(135deg,rgba(96,165,250,.5),transparent 42%,rgba(45,212,191,.28));content:""}.portrait{display:block;width:100%;aspect-ratio:1;object-fit:cover;border-radius:26px}.sections{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px;margin-top:72px}.card{padding:24px;border:1px solid rgba(148,163,184,.18);border-radius:24px;background:rgba(15,23,42,.62)}.card h2{margin:0 0 12px;font-size:1rem;letter-spacing:-.02em}.card p{margin:0;color:#a8b3c7;font-size:.98rem;line-height:1.6}footer{display:flex;flex-wrap:wrap;gap:16px;justify-content:space-between;margin-top:56px;padding-top:24px;border-top:1px solid rgba(148,163,184,.18);color:#94a3b8;font-size:.95rem}@media(max-width:860px){header{padding-bottom:42px}.hero{grid-template-columns:1fr;gap:36px}.portrait-card{max-width:320px;grid-row:1}.sections{grid-template-columns:1fr;margin-top:52px}}@media(max-width:560px){.page{width:min(100% - 28px,1120px);padding-top:22px}header{align-items:flex-start;flex-direction:column;gap:14px}.actions{align-items:stretch;flex-direction:column}.button{width:100%}}
</style>
</head>
<body><div class="page"><header><a class="logo" href={esPrefix || "/"}>Ignacio Parada</a><nav aria-label="Primary navigation"><a href={`${esPrefix}/cv/`}>{content.nav.cv}</a><a href={`${esPrefix}/repos/`}>{content.nav.repos}</a><a href="mailto:yo@ignacioparada.com">{content.nav.email}</a><a href="https://www.linkedin.com/in/iparada/">{content.nav.linkedin}</a><a class="lang" href={content.altPath}>{content.lang === "en" ? "ES" : "EN"}</a></nav></header><main><section class="hero" aria-labelledby="intro-title"><div><p class="kicker">{content.kicker}</p><h1 id="intro-title">{content.title}</h1><p class="lede">{content.lede}</p><div class="actions"><a class="button primary" href="mailto:yo@ignacioparada.com">{content.nav.email}</a><a class="button secondary" href={`${esPrefix}/cv/`}>{content.actions.cv}</a><a class="button secondary" href={`${esPrefix}/repos/`}>{content.actions.repos}</a><a class="button secondary" href="https://www.linkedin.com/in/iparada/">{content.actions.linkedin}</a></div></div><div class="portrait-card" aria-label="Portrait of Ignacio Parada"><img class="portrait" src="/images/ignacio-parada.jpg" alt="Ignacio Parada" /></div></section><section class="sections" aria-label={content.highlightsLabel}>{content.highlights.map((item) => <article class="card"><h2>{item.title}</h2><p>{item.text}</p></article>)}</section></main><footer>{content.footer.map((item) => <span>{item}</span>)}</footer></div></body></html>
