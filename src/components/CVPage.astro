---
const { content } = Astro.props;
const esPrefix = content.lang === "es" ? "/es" : "";
---
<html lang={content.lang}><head><meta charset="utf-8" /><link rel="icon" type="image/svg+xml" href="/favicon.svg" /><link rel="icon" href="/favicon.ico" /><meta name="viewport" content="width=device-width" /><meta name="generator" content={Astro.generator} /><meta name="description" content={content.description} /><link rel="alternate" hreflang="en" href="https://ignacioparada.com/cv/" /><link rel="alternate" hreflang="es" href="https://ignacioparada.com/es/cv/" /><title>{content.title}</title><style>
:root{font-family:Georgia,"Times New Roman",serif;color:#161616;background:#efeee9}*{box-sizing:border-box}body{margin:0;padding:40px 20px;background:#efeee9}a{color:inherit;text-decoration-thickness:1px;text-underline-offset:2px}.sheet{max-width:920px;margin:0 auto;padding:56px 64px;background:#fffdfa;box-shadow:0 24px 80px rgba(30,30,30,.12)}.site-nav{display:flex;gap:18px;justify-content:flex-end;margin-bottom:36px;font-family:Inter,ui-sans-serif,system-ui,sans-serif;font-size:.82rem;color:#555}.lang{padding-left:6px;border-left:1px solid #bbb}header.cv-header{border-bottom:2px solid #161616;padding-bottom:18px}h1{margin:0;font-size:2.45rem;line-height:1;letter-spacing:-.045em;text-transform:uppercase}.contact{margin-top:10px;font-family:Inter,ui-sans-serif,system-ui,sans-serif;font-size:.9rem;color:#333}section{margin-top:30px}h2{margin:0 0 14px;border-bottom:1px solid #b8b4aa;padding-bottom:5px;font-family:Inter,ui-sans-serif,system-ui,sans-serif;font-size:.86rem;letter-spacing:.13em;text-transform:uppercase}.entry{margin-top:18px}.entry:first-of-type{margin-top:0}.entry-head{display:grid;grid-template-columns:1fr auto;gap:16px;align-items:baseline}h3{margin:0;font-size:1.05rem;line-height:1.25}.period{font-family:Inter,ui-sans-serif,system-ui,sans-serif;font-size:.82rem;white-space:nowrap}.meta,.role{margin:3px 0 0;font-family:Inter,ui-sans-serif,system-ui,sans-serif;font-size:.88rem;color:#444}.role{font-weight:700;color:#222}ul{margin:8px 0 0 18px;padding:0}li{margin:4px 0;line-height:1.42}.additional{display:grid;gap:8px;margin:0;padding:0;list-style:none}.additional li{margin:0}.label{font-weight:700}.print-button{display:inline-flex;margin-top:28px;border:1px solid #161616;padding:9px 12px;font-family:Inter,ui-sans-serif,system-ui,sans-serif;font-size:.82rem;text-decoration:none}@media(max-width:720px){body{padding:0}.sheet{padding:32px 22px;box-shadow:none}.site-nav{justify-content:flex-start;flex-wrap:wrap}.entry-head{grid-template-columns:1fr;gap:3px}.period{white-space:normal}}@page{size:letter;margin:.55in}@media print{:root,body{background:white}body{padding:0}.sheet{max-width:none;padding:0;box-shadow:none}.site-nav,.print-button{display:none}section{break-inside:avoid;margin-top:22px}.entry{break-inside:avoid}a{text-decoration:none}}
</style></head><body><main class="sheet"><nav class="site-nav" aria-label="Site navigation"><a href={esPrefix || "/"}>{content.nav.home}</a><a href={`${esPrefix}/repos/`}>{content.nav.repos}</a><a href="mailto:yo@ignacioparada.com">{content.nav.email}</a><a class="lang" href={content.altPath}>{content.lang === "en" ? "ES" : "EN"}</a></nav><header class="cv-header"><h1>Ignacio Parada</h1><p class="contact"><a href="mailto:yo@ignacioparada.com">yo@ignacioparada.com</a> · +56 9 9872 6389 · <a href="https://www.linkedin.com/in/iparada/">linkedin.com/in/iparada</a></p></header><section aria-labelledby="education-title"><h2 id="education-title">{content.sectionLabels.education}</h2>{content.education.map((item) => <article class="entry"><div class="entry-head"><h3>{item.institution}</h3><span class="period">{item.period}</span></div><p class="meta">{item.location}</p><p class="role">{item.program}</p><ul>{item.items.map((detail) => <li>{detail}</li>)}</ul></article>)}</section><section aria-labelledby="experience-title"><h2 id="experience-title">{content.sectionLabels.experience}</h2>{content.experience.map((item) => <article class="entry"><div class="entry-head"><h3>{item.organization}</h3><span class="period">{item.period}</span></div><p class="meta">{item.location} · {item.context}</p><p class="role">{item.role}</p><ul>{item.items.map((detail) => <li>{detail}</li>)}</ul></article>)}</section><section aria-labelledby="additional-title"><h2 id="additional-title">{content.sectionLabels.additional}</h2><ul class="additional">{content.additional.map((item) => <li><span class="label">{item.label}</span> {item.text}</li>)}</ul></section><a class="print-button" href="javascript:window.print()">{content.print}</a></main></body></html>
