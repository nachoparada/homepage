---
const { content, items } = Astro.props;
const esPrefix = content.lang === "es" ? "/es" : "";
---
<html lang={content.lang}><head><meta charset="utf-8" /><link rel="icon" type="image/svg+xml" href="/favicon.svg" /><link rel="icon" href="/favicon.ico" /><meta name="viewport" content="width=device-width" /><meta name="generator" content={Astro.generator} /><meta name="description" content={content.description} /><link rel="alternate" hreflang="en" href="https://ignacioparada.com/repos/" /><link rel="alternate" hreflang="es" href="https://ignacioparada.com/es/repos/" /><title>{content.title}</title><style>
:root{color-scheme:dark;font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:#f8fafc;background:#020617}*{box-sizing:border-box}body{min-height:100vh;margin:0;background:radial-gradient(circle at top left,rgba(59,130,246,.18),transparent 34rem),radial-gradient(circle at bottom right,rgba(14,165,233,.14),transparent 32rem),#020617}a{color:inherit;text-decoration:none}.page{width:min(1120px,calc(100% - 40px));margin:0 auto;padding:32px 0 56px}header{display:flex;align-items:center;justify-content:space-between;gap:24px;padding:8px 0 58px}.logo{font-weight:800;letter-spacing:-.04em}nav{display:flex;gap:18px;color:#94a3b8;font-size:.95rem;flex-wrap:wrap}nav a:hover{color:#f8fafc}.lang{padding-left:6px;border-left:1px solid rgba(148,163,184,.3)}.kicker{display:inline-flex;margin:0 0 20px;padding:8px 12px;border:1px solid rgba(147,197,253,.28);border-radius:999px;background:rgba(59,130,246,.1);color:#bfdbfe;font-size:.78rem;font-weight:800;letter-spacing:.12em;text-transform:uppercase}h1{max-width:880px;margin:0;font-size:clamp(3rem,7vw,6rem);line-height:.94;letter-spacing:-.075em}.lede{max-width:760px;margin:24px 0 0;color:#cbd5e1;font-size:clamp(1.08rem,2vw,1.25rem);line-height:1.65}.repo-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px;margin-top:48px}.repo-card{display:flex;min-height:260px;flex-direction:column;justify-content:space-between;padding:24px;border:1px solid rgba(148,163,184,.18);border-radius:26px;background:rgba(15,23,42,.68);box-shadow:0 20px 60px rgba(0,0,0,.22)}.repo-card.private{border-color:rgba(251,191,36,.28);background:linear-gradient(145deg,rgba(15,23,42,.78),rgba(120,53,15,.18))}.repo-top{display:flex;align-items:flex-start;justify-content:space-between;gap:18px}.repo-name{margin:0;font-size:1.35rem;letter-spacing:-.035em}.badge{flex:0 0 auto;padding:6px 10px;border-radius:999px;background:rgba(34,197,94,.12);color:#bbf7d0;font-size:.75rem;font-weight:800;letter-spacing:.08em;text-transform:uppercase}.badge.private{background:rgba(251,191,36,.14);color:#fde68a}.description{margin:18px 0 0;color:#cbd5e1;line-height:1.6}.stack{margin:18px 0 0;color:#93c5fd;font-size:.94rem;font-weight:700}.repo-footer{margin-top:28px;color:#94a3b8;font-size:.95rem}.repo-footer a{color:#f8fafc;font-weight:800}.private-note{color:#fde68a}footer{display:flex;flex-wrap:wrap;gap:16px;justify-content:space-between;margin-top:56px;padding-top:24px;border-top:1px solid rgba(148,163,184,.18);color:#94a3b8;font-size:.95rem}@media(max-width:780px){.repo-grid{grid-template-columns:1fr}}@media(max-width:560px){.page{width:min(100% - 28px,1120px);padding-top:22px}header{align-items:flex-start;flex-direction:column;gap:14px;padding-bottom:40px}.repo-top{align-items:flex-start;flex-direction:column}}
</style></head><body><div class="page"><header><a class="logo" href={esPrefix || "/"}>Ignacio Parada</a><nav aria-label="Primary navigation"><a href={esPrefix || "/"}>{content.nav.home}</a><a href={`${esPrefix}/cv/`}>{content.nav.cv}</a><a href={`${esPrefix}/repos/`}>{content.nav.repos}</a><a href="mailto:yo@ignacioparada.com">{content.nav.email}</a><a href="https://www.linkedin.com/in/iparada/">{content.nav.linkedin}</a><a class="lang" href={content.altPath}>{content.lang === "en" ? "ES" : "EN"}</a></nav></header><main><section aria-labelledby="repos-title"><p class="kicker">{content.kicker}</p><h1 id="repos-title">{content.heading}</h1><p class="lede">{content.lede}</p><div class="repo-grid">{items.map((repo) => <article class={`repo-card ${repo.visibility === "Private" ? "private" : ""}`}><div><div class="repo-top"><h2 class="repo-name">{repo.name}</h2><span class={`badge ${repo.visibility === "Private" ? "private" : ""}`}>{repo.visibility === "Private" ? content.privateLabel : content.publicLabel}</span></div><p class="description">{repo.description[content.lang]}</p><p class="stack">{repo.stack}</p></div><div class="repo-footer">{repo.url ? <a href={repo.url}>{content.view}</a> : <span class="private-note">{content.privateNote}</span>}</div></article>)}</div></section></main><footer>{content.footer.map((item) => <span>{item}</span>)}</footer></div></body></html>
